---
import '../styles/global.css';
import { site } from '../site';
import Masthead from '../components/Masthead.astro';

interface Props {
  title?: string;
  description?: string;
  /** nav item to mark current */
  current?: string;
  /** absolute or root-relative OG image; defaults to the site card */
  ogImage?: string;
  ogImageAlt?: string;
  /** "website" (default) or "article" for a note */
  type?: 'website' | 'article';
  /** article only, ISO strings */
  publishedTime?: string;
  modifiedTime?: string;
  /** article only */
  tags?: string[];
  section?: string;
  /** page-specific JSON-LD node(s), merged into the site graph */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** widen the main column (index / wide content) */
  wide?: boolean;
}

const {
  title,
  description = site.description,
  current,
  ogImage = site.ogImage,
  ogImageAlt = site.ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  section,
  jsonLd,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageAbs = new URL(ogImage, site.url).href;
const year = new Date().getFullYear();

// Meta descriptions and previews get truncated by every consumer anyway; keep a
// tight one so search snippets read as whole sentences.
const metaDescription =
  description.length > 158 ? description.slice(0, 155).replace(/\s+\S*$/, '') + '…' : description;

// Site-wide structured data: the blog, its author, and a search action that
// deep-links the map's spyglass. Page-specific nodes (BlogPosting, breadcrumbs)
// are appended by the caller via `jsonLd`.
const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.author,
  url: site.url,
};
const graph: Record<string, unknown>[] = [
  person,
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    description: site.description,
    inLanguage: 'en',
    publisher: { '@id': `${site.url}/#person` },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site.url}/map?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07080a" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={site.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    {type === 'article' && (
      <>
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {(modifiedTime ?? publishedTime) && (
          <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
        )}
        <meta property="article:author" content={site.author} />
        {section && <meta property="article:section" content={section} />}
        {tags.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — ${site.tagline}`}
      href="/rss.xml"
    />

    <script type="application/ld+json" set:html={structuredData} is:inline />
  </head>

  <body>
    <a href="#main" class="skip">skip to content</a>
    <Masthead current={current} />

    <main id="main" class:list={['wrap', wide ? 'wide' : 'reading']}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap wide">
        <span>{site.name}.com</span>
        <span class="dot">&middot;</span>
        <span>{site.tagline}</span>
        <span class="dot">&middot;</span>
        <span>&copy; {year}</span>
      </div>
    </footer>

    {/* Whisper-level corner nav. Compass -> this site's own admin (XH-6);
       chest -> Control Room, the infra dashboard (XH-11). Both auth-gated. */}
    <div class="corner-nav">
      <a
        href="https://admin.x-hakt.com"
        class="corner-nav__link"
        aria-label="ship's log — the editor"
        title="ship's log"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M12 12 15.5 8.5 12.8 11.2Z M12 12 8.5 15.5 11.2 12.8Z" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
          <circle cx="12" cy="12" r="1.1" fill="currentColor" />
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </a>
      <a
        href="https://bosun-x.x-hakt.com"
        class="corner-nav__link"
        aria-label="the chart room — bosun-x"
        title="the chart room"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M3 10.5V19a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-8.5M3 10.5 4.4 6a2 2 0 0 1 1.9-1.4h11.4A2 2 0 0 1 19.6 6L21 10.5M3 10.5h18M12 10.5v-3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <rect x="10.4" y="12.2" width="3.2" height="3.6" rx="0.6" fill="currentColor" />
        </svg>
      </a>
    </div>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-surface);
        color: var(--color-fg);
        padding: 8px 14px;
        font-family: var(--font-mono);
        font-size: 12px;
        z-index: 10;
      }
      .skip:focus { left: 8px; top: 8px; }

      main {
        padding-top: 56px;
        padding-bottom: 96px;
        min-height: 60vh;
      }

      .site-footer {
        border-top: 1px solid var(--border);
        background: var(--color-surface);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--color-faint);
        padding-block: 28px;
      }
      .site-footer .wrap { display: flex; gap: 10px; flex-wrap: wrap; }
      .site-footer .dot { color: var(--color-accent-bg); }

      .corner-nav {
        position: fixed;
        right: 12px;
        bottom: 10px;
        display: flex;
        gap: 2px;
        z-index: 5;
      }
      .corner-nav__link {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        color: var(--color-faint);
        opacity: 0.35;
        transition: opacity 0.15s, color 0.15s;
      }
      .corner-nav__link:hover, .corner-nav__link:focus-visible {
        opacity: 1;
        color: var(--color-seal-flat);
        text-decoration: none;
      }
      @media (max-width: 640px) { .corner-nav { right: 6px; bottom: 6px; } }
    </style>

    {/* Click any figure image to see it full size. XH-5: diagrams and screenshots
       render small in the reading column; this gives them a closer look. */}
    <div class="lightbox" id="lightbox" hidden>
      <img alt="" />
    </div>
    <style>
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: grid;
        place-items: center;
        padding: clamp(16px, 4vw, 48px);
        background: rgba(4, 5, 7, 0.92);
        cursor: zoom-out;
      }
      .lightbox[hidden] { display: none; }
      .lightbox img {
        max-width: 100%;
        max-height: 100%;
        border: 1px solid var(--border-2);
        border-radius: var(--radius-card);
        background: var(--color-surface);
      }
    </style>
    <script>
      const lb = document.getElementById('lightbox') as HTMLElement;
      const lbImg = lb.querySelector('img') as HTMLImageElement;
      const open = (src: string, alt: string) => {
        lbImg.src = src;
        lbImg.alt = alt;
        lb.hidden = false;
        document.documentElement.style.overflow = 'hidden';
      };
      const close = () => {
        lb.hidden = true;
        lbImg.removeAttribute('src');
        document.documentElement.style.overflow = '';
      };
      for (const img of document.querySelectorAll<HTMLImageElement>('.figure__scroll img')) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
      }
      lb.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lb.hidden) close();
      });
    </script>
  </body>
</html>
