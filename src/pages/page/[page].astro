---
// Page 1 of the note list lives at "/" (see src/pages/index.astro); this route
// serves page 2 and beyond from the current published notes.
import { publishedNotes } from '../../lib/notes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import Pagination from '../../components/Pagination.astro';
import { site } from '../../site';
import { NOTES_PAGE_SIZE } from '../../lib/pagination';

export const prerender = false;
const all = await publishedNotes();
const totalPages = Math.max(1, Math.ceil(all.length / NOTES_PAGE_SIZE));
const value = Astro.params.page ?? '';
if (!/^[1-9][0-9]*$/.test(value)) return new Response('Not found', { status: 404 });
const currentPage = Number(value);
if (currentPage === 1) return Astro.redirect('/');
if (currentPage > totalPages) return new Response('Not found', { status: 404 });
const notes = all.slice((currentPage - 1) * NOTES_PAGE_SIZE, currentPage * NOTES_PAGE_SIZE);

---

<BaseLayout
  current="notes"
  wide
  title={`notes — page ${currentPage}`}
  description={site.description}
>
  <NoteList notes={notes} />
  <Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
