---
export const prerender = false;
import NotePage from '../../components/NotePage.astro';
import { readPublishedSource, parseNote, validSlug } from '../../lib/notes';
import { renderNote } from '../../lib/render-note';
const slug = Astro.params.slug ?? '';
if (!validSlug(slug)) return new Response('Not found', { status: 404 });
const raw = await readPublishedSource(slug);
if (!raw) return new Response('Not found', { status: 404 });
let note;
try { note = parseNote(slug, raw); }
catch { return new Response('Not found', { status: 404 }); }
if (note.data.draft) return new Response('Not found', { status: 404 });
const html = await renderNote(note);
---
<NotePage note={note} html={html} />
