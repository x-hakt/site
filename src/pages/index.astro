---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import Pagination from '../components/Pagination.astro';
import { site } from '../site';
import { NOTES_PAGE_SIZE } from '../lib/pagination';

const notes = (await getCollection('notes', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalPages = Math.max(1, Math.ceil(notes.length / NOTES_PAGE_SIZE));
const pageNotes = notes.slice(0, NOTES_PAGE_SIZE);

const blog = {
  '@type': 'Blog',
  '@id': `${site.url}/#blog`,
  url: site.url,
  name: `${site.name} — ${site.tagline}`,
  description: site.description,
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#person` },
  blogPost: notes.map((n) => ({
    '@type': 'BlogPosting',
    headline: n.data.title,
    url: new URL(`/notes/${n.id}/`, site.url).href,
    datePublished: n.data.date.toISOString(),
    dateModified: (n.data.updated ?? n.data.date).toISOString(),
    author: { '@id': `${site.url}/#person` },
  })),
};
---

<BaseLayout current="notes" wide jsonLd={blog}>
  <section class="intro">
    <h1>{site.tagline}</h1>
    <img
      src="/emblem.png"
      width="200"
      height="200"
      class="intro__crest"
      alt={`The ${site.name} maker's seal: a bearded pirate skull in a ship's wheel over crossed cutlasses.`}
    />
  </section>

  <NoteList notes={pageNotes} />
  <Pagination currentPage={1} totalPages={totalPages} />
</BaseLayout>

<style>
  .intro {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-block: 24px 40px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .intro__crest {
    width: 168px;
    height: auto;
    flex-shrink: 0;
    opacity: 0.92;
  }
  @media (max-width: 640px) {
    .intro { flex-direction: column-reverse; align-items: flex-start; gap: 20px; }
    .intro__crest { width: 120px; align-self: center; }
  }
  .intro h1 {
    flex: 1;
    min-width: 0;
    font-size: clamp(1.6rem, 4.4vw, 2rem);
    letter-spacing: -0.02em;
    margin: 0;
  }
</style>
