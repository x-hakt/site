---
import BaseLayout from '../layouts/BaseLayout.astro';
/*
  Style guide s.07 — the one place the map metaphor gets to be the whole page.
  Cartographic illustration, two dry lines, a way back. Everything calm and mono.
  The hero emblem (XH-9) will sit faint behind this as a watermark later.
*/
---

<BaseLayout title="404" description="No chart for that route.">
  <section class="lost">
    <div class="lost__chart" role="img" aria-label="A torn nautical chart: a ship's wheel, rhumb lines, and island markers trailing off the edge">
      <svg viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="sea" width="22" height="22" patternUnits="userSpaceOnUse">
            <path d="M0 16 q5 -5 11 0 t11 0" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="320" height="200" fill="url(#sea)" />
        <g stroke="rgba(255,255,255,0.14)" stroke-width="0.8" stroke-dasharray="2 4">
          <line x1="60" y1="104" x2="270" y2="44" />
          <line x1="60" y1="104" x2="270" y2="104" />
          <line x1="60" y1="104" x2="250" y2="176" />
        </g>
        <g transform="translate(60 104)" stroke="#dfa11a" fill="none" stroke-width="1">
          <circle r="22" /><circle r="13" /><circle r="4" />
          <line x1="0" y1="-30" x2="0" y2="30" /><line x1="-30" y1="0" x2="30" y2="0" />
          <line x1="-21.2" y1="-21.2" x2="21.2" y2="21.2" /><line x1="-21.2" y1="21.2" x2="21.2" y2="-21.2" />
          <g fill="#dfa11a" stroke="none">
            <circle cx="0" cy="-30" r="2" /><circle cx="0" cy="30" r="2" />
            <circle cx="-30" cy="0" r="2" /><circle cx="30" cy="0" r="2" />
            <circle cx="-21.2" cy="-21.2" r="2" /><circle cx="21.2" cy="21.2" r="2" />
            <circle cx="-21.2" cy="21.2" r="2" /><circle cx="21.2" cy="-21.2" r="2" />
          </g>
        </g>
        <g font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="9" fill="#c3c4c7">
          <circle cx="272" cy="44" r="3" fill="#eaebec" /><text x="272" y="34" text-anchor="middle">last known</text>
          <circle cx="272" cy="104" r="3" fill="#eaebec" /><text x="272" y="120" text-anchor="middle">here</text>
        </g>
        <path d="M300 150 q10 20 -6 44" fill="none" stroke="rgba(255,255,255,0.14)" stroke-dasharray="1 5" />
        <text x="160" y="192" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, monospace" font-style="italic" font-size="10" fill="#8a6d3a">
          soundings run out past this point
        </text>
      </svg>
    </div>

    <h1>404 &mdash; no chart for that route.</h1>
    <p class="lost__aside">Either it was never drawn, or it sank.</p>
    <p class="lost__back"><a href="/">&#8592; back to notes</a></p>
  </section>
</BaseLayout>

<style>
  .lost { text-align: center; padding-block: 40px; }
  .lost__chart {
    max-width: 420px;
    margin: 0 auto 32px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: #0c0d10;
    padding: 18px;
  }
  .lost__chart svg { display: block; width: 100%; height: auto; }
  .lost h1 {
    font-size: 1.125rem;
    color: var(--color-fg);
    margin: 0 0 0.5rem;
  }
  .lost__aside {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-dim);
    margin: 0 0 1.5rem;
  }
  .lost__back { font-family: var(--font-mono); font-size: 12px; margin: 0; }
</style>
