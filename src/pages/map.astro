---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { trackMeta, trackSort, trackSlug } from '../tracks';

/*
  The map (XH-12, revised): every note, grouped by track, with the spyglass
  (client-side search) sitting above it. The grouped map is fully static; the
  spyglass is progressive enhancement over /search.json. A note with more than
  one track is listed under each.
*/
const notes = (await getCollection('notes', ({ data }) => import.meta.env.PROD ? !data.draft : true)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium' });
const techSlug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// group: track -> notes
const byTrack = new Map<string, typeof notes>();
for (const note of notes) {
  for (const track of note.data.tracks) {
    if (!byTrack.has(track)) byTrack.set(track, []);
    byTrack.get(track)!.push(note);
  }
}
const trackNames = [...byTrack.keys()].sort(trackSort);

// tech tally
const techCount = new Map<string, number>();
for (const note of notes) for (const t of note.data.tech) techCount.set(t, (techCount.get(t) ?? 0) + 1);
const tech = [...techCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="the map" description="Every note, grouped by the kind of work it is." current="map" wide>
  <section class="map-head">
    <h1>the map</h1>
    <p>Every note, grouped by the kind of work it is. Take a spyglass to it, or read down the list.</p>
    <label class="spyglass">
      <span class="spyglass__icon" aria-hidden="true">&#9906;</span>
      <input
        type="search"
        id="spyglass"
        placeholder="spyglass: search titles, text, tech…"
        autocomplete="off"
        aria-label="Search notes"
      />
    </label>
    <p class="spyglass__status" id="spyglass-status" aria-live="polite" hidden></p>
  </section>

  <ol class="results" id="results" hidden></ol>

  <div id="chart">
    {trackNames.length === 0 && <p class="empty">No charts drawn yet. The ink is still wet.</p>}
    {
      trackNames.map((track) => (
        <section class="track" id={`track-${trackSlug(track)}`}>
          <header class="track__head">
            <h2>{track}</h2>
            {trackMeta(track).blurb && <p class="track__blurb">{trackMeta(track).blurb}</p>}
          </header>
          <ul class="track__notes" role="list">
            {byTrack.get(track)!.map((note) => (
              <li class="chart-note">
                <a href={`/notes/${note.id}`}>
                  <span class="chart-note__date">{dateFmt.format(note.data.date)}</span>
                  <span class="chart-note__title">{note.data.title}</span>
                  <span class="chart-note__summary">{note.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  {
    tech.length > 0 && (
      <section class="toolbox" id="the-toolbox">
        <h2>the toolbox</h2>
        <p class="toolbox__note">Every technology that has turned up in a note. Follow one to see where.</p>
        <ul class="toolbox__list" role="list">
          {tech.map(([tag, n]) => (
            <li>
              <a href={`/tech/${techSlug(tag)}`}>
                {tag}
                <span class="toolbox__n">{n}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<script>
  type Row = {
    title: string;
    summary: string;
    url: string;
    date: string;
    tracks: string[];
    tech: string[];
    text: string;
  };

  const input = document.getElementById('spyglass') as HTMLInputElement;
  const results = document.getElementById('results') as HTMLOListElement;
  const chart = document.getElementById('chart') as HTMLElement;
  const box = document.querySelector('.toolbox') as HTMLElement | null;
  const status = document.getElementById('spyglass-status') as HTMLElement | null;
  if (!input || !results || !chart) throw new Error('spyglass: missing nodes');

  let rows: Row[] = [];
  let loaded = false;

  async function load() {
    if (loaded) return;
    const res = await fetch('/search.json');
    rows = await res.json();
    loaded = true;
  }

  function score(row: Row, terms: string[]): number {
    const hay = (row.title + ' ' + row.summary + ' ' + row.tracks.join(' ') + ' ' + row.tech.join(' ')).toLowerCase();
    const body = row.text.toLowerCase();
    let s = 0;
    for (const t of terms) {
      if (row.title.toLowerCase().includes(t)) s += 8;
      else if (hay.includes(t)) s += 4;
      else if (body.includes(t)) s += 1;
      else return -1; // every term must match somewhere
    }
    return s;
  }

  function esc(s: string) {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  }

  function render(q: string) {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) {
      results.hidden = true;
      results.innerHTML = '';
      chart.hidden = false;
      if (box) box.hidden = false;
      if (status) status.hidden = true;
      return;
    }
    const hits = rows
      .map((r) => ({ r, s: score(r, terms) }))
      .filter((x) => x.s >= 0)
      .sort((a, b) => b.s - a.s || b.r.date.localeCompare(a.r.date));

    chart.hidden = true;
    if (box) box.hidden = true;
    results.hidden = false;
    if (status) {
      status.hidden = false;
      status.textContent = `${hits.length} ${hits.length === 1 ? 'note' : 'notes'} in sight`;
    }
    results.innerHTML =
      hits
        .map(
          ({ r }) => `
      <li class="chart-note">
        <a href="${r.url}">
          <span class="chart-note__date">${r.date}</span>
          <span class="chart-note__title">${esc(r.title)}</span>
          <span class="chart-note__summary">${esc(r.summary)}</span>
          <span class="chart-note__where">${[...r.tracks, ...r.tech].map(esc).join(' · ')}</span>
        </a>
      </li>`,
        )
        .join('') || `<li class="chart-note chart-note--none">Nothing on the horizon for “${esc(q)}”.</li>`;
  }

  input.addEventListener('focus', load, { once: true });
  let t: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(t);
    t = window.setTimeout(async () => {
      await load();
      render(input.value.trim());
    }, 120);
  });

  // deep link: /map?q=term
  const q0 = new URLSearchParams(location.search).get('q');
  if (q0) {
    input.value = q0;
    load().then(() => render(q0));
  }
</script>

<style>
  .map-head { border-bottom: 1px solid var(--border); padding-bottom: 24px; margin-bottom: 8px; }
  .map-head h1 { font-size: clamp(1.6rem, 4.4vw, 2rem); letter-spacing: -0.02em; margin: 0 0 0.5rem; }
  .map-head > p { color: var(--color-fg-soft); max-width: 60ch; margin: 0 0 1.25rem; }

  .spyglass {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    padding: 0 12px;
    max-width: 32rem;
  }
  .spyglass:focus-within { border-color: var(--color-green); }
  .spyglass__icon { color: var(--color-dim); font-size: 15px; }
  .spyglass input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 11px 0;
  }
  .spyglass input::placeholder { color: var(--color-faint); }
  .spyglass__status {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-faint);
    margin: 10px 0 0;
  }

  .results { list-style: none; margin: 8px 0 0; padding: 0; }

  .track { padding-block: 28px; border-bottom: 1px solid var(--border); }
  .track__head h2 {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.3rem;
  }
  .track__blurb { color: var(--color-dim); font-size: 14px; margin: 0 0 1rem; max-width: 64ch; }

  .track__notes, .results { list-style: none; margin: 0; padding: 0; }

  .chart-note { border-top: 1px solid var(--border); }
  .chart-note:first-child { border-top: 0; }
  .chart-note a {
    display: grid;
    grid-template-columns: 108px 1fr;
    gap: 4px 22px;
    padding: 13px 0;
    color: inherit;
  }
  .chart-note a:hover { text-decoration: none; }
  .chart-note a:hover .chart-note__title { color: var(--color-green); }
  .chart-note__date {
    grid-row: 1 / span 3;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-faint);
    padding-top: 2px;
  }
  .chart-note__title { font-family: var(--font-mono); font-weight: 600; font-size: 14px; color: var(--color-fg); }
  .chart-note__summary { color: var(--color-dim); font-size: 14px; max-width: 64ch; }
  .chart-note__where { font-family: var(--font-mono); font-size: 11px; color: var(--color-faint); }
  .chart-note--none { padding: 14px 0; font-family: var(--font-mono); font-size: 13px; color: var(--color-faint); }

  .toolbox { padding-top: 30px; }
  .toolbox h2 { font-size: 1rem; margin: 0 0 0.3rem; }
  .toolbox__note { color: var(--color-dim); font-size: 14px; margin: 0 0 1rem; }
  .toolbox__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .toolbox__list a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 11px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-soft);
  }
  .toolbox__list a:hover { border-color: var(--color-green); color: var(--color-green); text-decoration: none; }
  .toolbox__n { color: var(--color-faint); font-size: 10px; }

  .empty { color: var(--color-faint); font-family: var(--font-mono); font-size: 13px; padding: 20px 0; }

  @media (max-width: 640px) {
    .chart-note a { grid-template-columns: 1fr; gap: 3px; }
    .chart-note__date { grid-row: auto; }
  }
</style>
