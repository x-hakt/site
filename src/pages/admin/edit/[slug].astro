---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  COOKIE,
  adminEnabled,
  sessionValid,
  validSlug,
  noteExists,
  readNote,
  newNoteTemplate,
} from '../../../lib/admin';

if (!adminEnabled()) return new Response('Not found', { status: 404 });
if (!sessionValid(Astro.cookies.get(COOKIE)?.value)) return Astro.redirect('/admin?e=session');

const slug = Astro.params.slug ?? '';
if (!validSlug(slug)) return new Response('Bad slug', { status: 400 });

const wantNew = Astro.url.searchParams.get('new') === '1';
const exists = await noteExists(slug);

let content: string;
let isNew: boolean;
if (exists) {
  content = await readNote(slug);
  isNew = false;
} else if (wantNew) {
  content = newNoteTemplate(slug);
  isNew = true;
} else {
  return Astro.redirect('/admin');
}
---

<BaseLayout title={`edit ${slug}`} description="Editor." wide>
  <section class="editor">
    <p class="editor__crumb"><a href="/admin">&#8592; the chart room</a> / {isNew ? 'new' : 'edit'} / {slug}</p>

    <div id="draft-bar" class="editor__draft" hidden>
      unsaved local draft found <span id="draft-when"></span> —
      <button type="button" id="draft-restore">restore it</button>
      <button type="button" id="draft-discard">discard</button>
    </div>

    <form method="post" action="/admin/save" class="editor__form">
      <input type="hidden" name="slug" value={slug} />
      <input type="hidden" name="isNew" value={isNew ? '1' : '0'} />
      <textarea name="content" spellcheck="false" aria-label={`MDX source for ${slug}`}>{content}</textarea>
      <div class="editor__bar">
        <button type="submit">save &amp; publish</button>
        <span class="editor__hint">save runs the build; a broken note is reverted, not shipped. ~15s. Your text is also kept in this browser until a save lands.</span>
        <a class="editor__view" href={`/notes/${slug}`} target="_blank" rel="noopener">view note &#8599;</a>
      </div>
    </form>
  </section>
</BaseLayout>

<script define:vars={{ slug }}>
  // Keep the textarea's content in localStorage so a failed save (or a stray
  // navigation, or a browser crash) never loses the draft. Cleared only when the
  // server content matches — i.e. a save actually landed — or on "discard".
  const KEY = `xh-admin-draft:${slug}`;
  const ta = document.querySelector('textarea[name="content"]');
  const bar = document.getElementById('draft-bar');
  const serverContent = ta.value;

  let stored = null;
  try { stored = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { /* ignore */ }

  if (stored && typeof stored.content === 'string') {
    if (stored.content === serverContent) {
      localStorage.removeItem(KEY); // the last save landed
    } else {
      document.getElementById('draft-when').textContent =
        stored.at ? `(${new Date(stored.at).toLocaleString()})` : '';
      bar.hidden = false;
      document.getElementById('draft-restore').onclick = () => {
        ta.value = stored.content;
        bar.hidden = true;
        ta.focus();
      };
      document.getElementById('draft-discard').onclick = () => {
        localStorage.removeItem(KEY);
        bar.hidden = true;
      };
    }
  }

  let t;
  ta.addEventListener('input', () => {
    clearTimeout(t);
    t = setTimeout(() => {
      try { localStorage.setItem(KEY, JSON.stringify({ content: ta.value, at: Date.now() })); } catch { /* quota */ }
    }, 700);
  });
</script>

<style>
  .editor { max-width: var(--text-wide); }
  .editor__crumb { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-faint); margin: 0 0 1rem; }
  .editor__crumb a { color: var(--color-dim); }

  .editor__draft {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-amber);
    border: 1px solid rgba(223, 161, 26, 0.4);
    border-radius: var(--radius-card);
    padding: 9px 12px;
    margin-bottom: 12px;
  }
  .editor__draft button {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 9px;
    margin-left: 6px;
    background: var(--color-raised);
    border: 1px solid var(--border-2);
    border-radius: 5px;
    color: var(--color-fg-soft);
    cursor: pointer;
  }
  .editor__draft button:hover { border-color: var(--color-green); color: var(--color-green); }

  .editor__form { display: flex; flex-direction: column; gap: 12px; }
  textarea {
    width: 100%;
    min-height: 62vh;
    resize: vertical;
    background: var(--color-surface);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    color: var(--color-fg-soft);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    padding: 16px;
    tab-size: 2;
  }
  textarea:focus { outline: 0; border-color: var(--color-green); }

  .editor__bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  button {
    background: var(--color-raised);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    color: var(--color-fg-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 10px 18px;
    cursor: pointer;
  }
  button:hover { border-color: var(--color-green); color: var(--color-green); }
  .editor__hint { font-family: var(--font-mono); font-size: 11px; color: var(--color-faint); }
  .editor__view { font-family: var(--font-mono); font-size: 12px; margin-left: auto; }
</style>
