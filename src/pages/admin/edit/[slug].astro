---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  COOKIE,
  adminEnabled,
  sessionValid,
  validSlug,
  noteExists,
  readNote,
  newNoteTemplate,
} from '../../../lib/admin';

if (!adminEnabled()) return new Response('Not found', { status: 404 });
if (!sessionValid(Astro.cookies.get(COOKIE)?.value)) return Astro.redirect('/admin?e=session');

const slug = Astro.params.slug ?? '';
if (!validSlug(slug)) return new Response('Bad slug', { status: 400 });

const wantNew = Astro.url.searchParams.get('new') === '1';
const exists = await noteExists(slug);

let content: string;
let isNew: boolean;
if (exists) {
  content = await readNote(slug);
  isNew = false;
} else if (wantNew) {
  content = newNoteTemplate(slug);
  isNew = true;
} else {
  return Astro.redirect('/admin');
}
---

<BaseLayout title={`edit ${slug}`} description="Editor." wide>
  <section class="editor">
    <p class="editor__crumb"><a href="/admin">&#8592; the chart room</a> / {isNew ? 'new' : 'edit'} / {slug}</p>

    <form method="post" action="/admin/save" class="editor__form">
      <input type="hidden" name="slug" value={slug} />
      <input type="hidden" name="isNew" value={isNew ? '1' : '0'} />
      <textarea name="content" spellcheck="false" aria-label={`MDX source for ${slug}`}>{content}</textarea>
      <div class="editor__bar">
        <button type="submit">save &amp; publish</button>
        <span class="editor__hint">save runs the build; a broken note is reverted, not shipped. ~15s.</span>
        <a class="editor__view" href={`/notes/${slug}`} target="_blank" rel="noopener">view note &#8599;</a>
      </div>
    </form>
  </section>
</BaseLayout>

<style>
  .editor { max-width: var(--text-wide); }
  .editor__crumb { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-faint); margin: 0 0 1rem; }
  .editor__crumb a { color: var(--color-dim); }

  .editor__form { display: flex; flex-direction: column; gap: 12px; }
  textarea {
    width: 100%;
    min-height: 62vh;
    resize: vertical;
    background: var(--color-surface);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    color: var(--color-fg-soft);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    padding: 16px;
    tab-size: 2;
  }
  textarea:focus { outline: 0; border-color: var(--color-green); }

  .editor__bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  button {
    background: var(--color-raised);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    color: var(--color-fg-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 10px 18px;
    cursor: pointer;
  }
  button:hover { border-color: var(--color-green); color: var(--color-green); }
  .editor__hint { font-family: var(--font-mono); font-size: 11px; color: var(--color-faint); }
  .editor__view { font-family: var(--font-mono); font-size: 12px; margin-left: auto; }
</style>
