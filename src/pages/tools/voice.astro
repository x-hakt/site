---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../site';
import { sections, questionCount } from '../../lib/voice-questions';

const app = {
  '@type': 'WebApplication',
  '@id': `${site.url}/tools/voice/#app`,
  name: 'voice profile builder',
  url: `${site.url}/tools/voice/`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  description:
    'A deep questionnaire that assembles a portable VOICE.md style card for AI writing tools. Runs entirely in the browser.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout
  title="voice profile builder"
  description="Answer a deep questionnaire about how you write; get a VOICE.md style card any AI can follow. Runs in your browser, sends nothing anywhere."
  current="tools"
  wide
  jsonLd={app}
>
  <section class="vhead">
    <p class="vhead__crumb"><a href="/tools">the workbench</a> / voice profile builder</p>
    <h1>voice profile builder</h1>
    <p class="vhead__lede">
      Every AI writing tool will happily match a voice if you describe it well enough. The describing
      is the hard part. Answer these {questionCount} questions in your own words, paste a few real
      samples, and this assembles a <code>VOICE.md</code> you can hand to Claude, ChatGPT, or a custom
      style so its drafts stop sounding like everyone else’s.
    </p>
    <p class="vhead__note">
      Nothing leaves your browser. Answers autosave locally so you can come back to it. The two
      sections that matter most are <strong>the tells</strong> and the <strong>pairs</strong> at the
      end.
    </p>
  </section>

  <form id="voice-form" class="vform">
    {sections.map((section, si) => (
      <fieldset class="vsec" id={`sec-${section.id}`}>
        <legend>
          <span class="vsec__n">{String(si + 1).padStart(2, '0')}</span>
          {section.title}
        </legend>
        <p class="vsec__intro">{section.intro}</p>
        {section.questions.map((q) => (
          <div class="vq">
            <label for={q.id}>{q.label}</label>
            {q.hint && <p class="vq__hint">{q.hint}</p>}
            <textarea
              id={q.id}
              name={q.id}
              rows={q.rows ?? 3}
              data-label={q.label}
              data-section={section.title}
              placeholder={q.placeholder}
            ></textarea>
          </div>
        ))}
      </fieldset>
    ))}
  </form>

  <div class="vbar" id="voice-bar">
    <span class="vbar__count" id="voice-count">0 / {questionCount} answered</span>
    <div class="vbar__actions">
      <button type="button" class="btn btn--ghost" id="voice-reset">reset</button>
      <button type="button" class="btn" id="voice-build">build VOICE.md</button>
    </div>
  </div>

  <section class="vout" id="voice-out" hidden>
    <h2>your VOICE.md</h2>
    <p>
      Download it, or copy it. The file starts with per-tool instructions for where it goes. For
      Claude/ChatGPT custom-instruction fields, paste just the <em>Style instructions</em> block;
      for a repo or a Project, give it the whole file.
    </p>
    <div class="vout__actions">
      <button type="button" class="btn" id="voice-download">download VOICE.md</button>
      <button type="button" class="btn btn--ghost" id="voice-copy">copy</button>
      <span class="vout__msg" id="voice-msg" aria-live="polite"></span>
    </div>
    <pre class="vout__pre" id="voice-pre"></pre>
  </section>
</BaseLayout>

<script>
  const STORE = 'x-hakt:voice:v1';
  const form = document.getElementById('voice-form') as HTMLFormElement;
  const fields = Array.from(form.querySelectorAll('textarea[data-label]')) as HTMLTextAreaElement[];
  const countEl = document.getElementById('voice-count') as HTMLElement;
  const out = document.getElementById('voice-out') as HTMLElement;
  const pre = document.getElementById('voice-pre') as HTMLElement;
  const msg = document.getElementById('voice-msg') as HTMLElement;
  const total = fields.length;

  function load() {
    let saved: Record<string, string> = {};
    try {
      saved = JSON.parse(localStorage.getItem(STORE) || '{}');
    } catch {
      saved = {};
    }
    for (const f of fields) if (saved[f.id]) f.value = saved[f.id];
    refresh();
  }

  function save() {
    const data: Record<string, string> = {};
    for (const f of fields) if (f.value.trim()) data[f.id] = f.value;
    try {
      localStorage.setItem(STORE, JSON.stringify(data));
    } catch {
      /* private mode / full quota — the form still works, it just won't persist */
    }
  }

  function refresh() {
    const done = fields.filter((f) => f.value.trim()).length;
    countEl.textContent = `${done} / ${total} answered`;
  }

  function build(): string {
    const today = new Date().toISOString().slice(0, 10);
    const answers = fields.filter((f) => f.value.trim());

    const isSamples = (f: HTMLTextAreaElement) => f.dataset.section === 'Samples & pairs';
    const styleFields = answers.filter((f) => !isSamples(f));
    const sampleFields = answers.filter((f) => isSamples(f));

    const bySection = new Map<string, HTMLTextAreaElement[]>();
    for (const f of styleFields) {
      const s = f.dataset.section || 'Other';
      if (!bySection.has(s)) bySection.set(s, []);
      bySection.get(s)!.push(f);
    }

    const lines: string[] = [];
    lines.push(`# Voice profile — ${today}`, '');
    lines.push(
      'Built with the voice profile builder at x-hakt.com/tools/voice. Give this to an AI so its',
      'writing sounds like the person who filled it in.',
      '',
      '## How to use this',
      '',
      '- **Claude Code / Codex / Cursor:** save as `VOICE.md` in your project, then add to `CLAUDE.md` /',
      '  `AGENTS.md`: "When you write prose, follow `./VOICE.md`."',
      '- **Claude.ai:** Settings → Custom Styles → *Create style* → paste the **Style instructions** block',
      '  below. Or add this whole file to a Project’s knowledge.',
      '- **ChatGPT:** Settings → Personalization → Custom Instructions → paste the **Style instructions**',
      '  block. Or add this file to a Project.',
      '- **Anything else:** prepend the **Style instructions** block as a system prompt.',
      '',
      'Optional first step — run it through your AI once to compress it:',
      '',
      '> Here is a description of how I write, plus samples. Produce a reusable style guide of at most',
      '> 400 words that another AI can follow to write in my voice. Lead with the hard rules (what to',
      '> never do), then rhythm, then vocabulary and tone. No preamble, no restating the task.',
      '',
      '---',
      '',
      '## Style instructions',
      '',
    );

    for (const [section, items] of bySection) {
      lines.push(`### ${section}`, '');
      for (const f of items) {
        lines.push(`**${f.dataset.label}**`, '', f.value.trim(), '');
      }
    }

    if (sampleFields.length) {
      lines.push('---', '', '## Samples', '');
      for (const f of sampleFields) {
        lines.push(`### ${f.dataset.label}`, '', f.value.trim(), '');
      }
    }

    return lines.join('\n').replace(/\n{3,}/g, '\n\n').trimEnd() + '\n';
  }

  function show(text: string) {
    pre.textContent = text;
    out.hidden = false;
    out.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  form.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).tagName === 'TEXTAREA') {
      save();
      refresh();
    }
  });

  document.getElementById('voice-build')!.addEventListener('click', () => {
    if (fields.every((f) => !f.value.trim())) {
      msg.textContent = '';
      show('Answer a few questions first.');
      return;
    }
    show(build());
  });

  document.getElementById('voice-reset')!.addEventListener('click', () => {
    if (!confirm('Clear every answer and start over?')) return;
    for (const f of fields) f.value = '';
    try {
      localStorage.removeItem(STORE);
    } catch {
      /* ignore */
    }
    refresh();
    out.hidden = true;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  document.getElementById('voice-download')!.addEventListener('click', () => {
    const blob = new Blob([pre.textContent || ''], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'VOICE.md';
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('voice-copy')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(pre.textContent || '');
      msg.textContent = 'copied';
    } catch {
      msg.textContent = 'select the text and copy manually';
    }
    setTimeout(() => (msg.textContent = ''), 2000);
  });

  load();
</script>

<style>
  .vhead { border-bottom: 1px solid var(--border); padding-bottom: 24px; margin-bottom: 8px; }
  .vhead__crumb { font-family: var(--font-mono); font-size: 12px; color: var(--color-faint); margin: 0 0 0.75rem; }
  .vhead h1 { font-size: clamp(1.6rem, 4.4vw, 2rem); letter-spacing: -0.02em; margin: 0 0 0.6rem; }
  .vhead__lede { color: var(--color-fg-soft); max-width: 66ch; margin: 0 0 0.75rem; }
  .vhead__note { color: var(--color-dim); font-size: 14px; max-width: 66ch; margin: 0; }

  .vform { margin: 0; padding: 0; border: 0; }

  .vsec { border: 0; border-bottom: 1px solid var(--border); margin: 0; padding: 28px 0; }
  .vsec legend {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-fg);
    letter-spacing: -0.01em;
    padding: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .vsec__n { font-size: 12px; color: var(--color-green); }
  .vsec__intro { color: var(--color-dim); font-size: 14px; max-width: 66ch; margin: 0.4rem 0 1.4rem; }

  .vq { margin-bottom: 1.5rem; }
  .vq label {
    display: block;
    font-size: 14.5px;
    color: var(--color-fg-soft);
    margin-bottom: 0.3rem;
    max-width: 70ch;
  }
  .vq__hint { color: var(--color-faint); font-size: 12.5px; margin: 0 0 0.45rem; max-width: 68ch; }

  textarea {
    width: 100%;
    max-width: 46rem;
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    padding: 10px 12px;
    resize: vertical;
  }
  textarea:focus { outline: 0; border-color: var(--color-green); }
  textarea::placeholder { color: var(--color-faint); }

  .vbar {
    position: sticky;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border-top: 1px solid var(--border-2);
    padding: 14px 0;
    margin-top: 8px;
  }
  .vbar__count { font-family: var(--font-mono); font-size: 12px; color: var(--color-dim); }
  .vbar__actions { display: flex; gap: 10px; }

  .btn {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 9px 16px;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-green);
    background: color-mix(in srgb, var(--color-green) 14%, transparent);
    color: var(--color-green);
    cursor: pointer;
  }
  .btn:hover { background: color-mix(in srgb, var(--color-green) 22%, transparent); }
  .btn--ghost { border-color: var(--border-2); background: transparent; color: var(--color-dim); }
  .btn--ghost:hover { color: var(--color-fg); background: var(--color-accent-bg); }

  .vout { padding-top: 30px; }
  .vout h2 { font-size: 1rem; margin: 0 0 0.4rem; }
  .vout > p { color: var(--color-dim); font-size: 14px; max-width: 66ch; margin: 0 0 1rem; }
  .vout__actions { display: flex; align-items: center; gap: 12px; margin-bottom: 1rem; }
  .vout__msg { font-family: var(--font-mono); font-size: 11px; color: var(--color-green); }
  .vout__pre {
    background: var(--color-surface);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-fg-soft);
    white-space: pre-wrap;
    overflow-x: auto;
    max-height: 60vh;
  }

  @media (max-width: 640px) {
    .vbar { flex-direction: column; align-items: stretch; gap: 10px; }
    .vbar__actions { justify-content: flex-end; }
  }
</style>
