---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../site';

const entry = await getEntry('docs', 'bosun-x');
if (!entry) throw new Error('docs/bosun-x.md missing');
const { Content } = await render(entry);
const { title, summary, repo, npm } = entry.data;

const app = {
  '@type': 'SoftwareSourceCode',
  '@id': `${site.url}/locker/bosun-x/#src`,
  name: title,
  description: summary,
  url: `${site.url}/locker/bosun-x/`,
  codeRepository: repo,
  programmingLanguage: 'JavaScript',
  runtimePlatform: 'Node.js',
  license: 'https://spdx.org/licenses/MIT.html',
};
---

<BaseLayout title={title} description={summary} current="locker" jsonLd={app}>
  <section class="bhead">
    <p class="bhead__crumb"><a href="/locker">x’s locker</a> / bosun-x</p>
    <p class="bhead__kind">a tool you install — not one that runs here</p>
    <div class="bhead__links">
      {repo && (
        <a href={repo} rel="noopener">
          repo <span aria-hidden="true">↗</span>
        </a>
      )}
      {npm && (
        <a href={`https://www.npmjs.com/package/${npm}`} rel="noopener">
          npm: {npm} <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
    <p class="bhead__mirror">
      This page mirrors the project’s README. The source of truth is
      {repo ? <a href={repo} rel="noopener">the repo</a> : 'the repo'}.
    </p>
  </section>

  <article class="prose bdoc">
    <Content />
  </article>
</BaseLayout>

<style>
  .bhead { border-bottom: 1px solid var(--border); padding-bottom: 22px; margin-bottom: 28px; }
  .bhead__crumb { font-family: var(--font-mono); font-size: 12px; color: var(--color-faint); margin: 0 0 0.6rem; }
  .bhead__kind {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-amber);
    border: 1px solid var(--color-amber);
    border-radius: 999px;
    padding: 2px 10px;
    margin: 0 0 0.9rem;
  }
  .bhead__links { display: flex; flex-wrap: wrap; gap: 16px; font-family: var(--font-mono); font-size: 12.5px; margin: 0 0 0.75rem; }
  .bhead__links a { color: var(--color-green); }
  .bhead__mirror { color: var(--color-dim); font-size: 13px; margin: 0; }

  .bdoc { margin-inline: 0; }
  .bdoc :global(h1) { font-size: clamp(1.7rem, 4.4vw, 2.1rem); letter-spacing: -0.02em; margin: 0 0 0.4rem; }
  .bdoc :global(h1 + p) { color: var(--color-fg-soft); font-size: 1.05rem; }
  .bdoc :global(table) { font-size: 0.92rem; }
  .bdoc :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 2.2rem 0; }
</style>
